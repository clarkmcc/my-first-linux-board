# Boot Console is powered exclusively from USB VBUS. Report its 500 mA
# bring-up budget instead of the legacy gadget's self-powered, zero-current
# descriptor. This declares the configured load; it does not enforce or
# measure board current.
--- a/drivers/usb/gadget/legacy/serial.c
+++ b/drivers/usb/gadget/legacy/serial.c
@@ -134,7 +134,8 @@
 	/* .label = f(use_acm) */
 	/* .bConfigurationValue = f(use_acm) */
 	/* .iConfiguration = DYNAMIC */
-	.bmAttributes	= USB_CONFIG_ATT_SELFPOWER,
+	.bmAttributes	= USB_CONFIG_ATT_ONE,
+	.MaxPower	= 500,
 };
 
 static struct usb_function_instance *fi_serial[MAX_U_SERIAL_PORTS];
