#!/bin/sh

case "$1" in
	start)
		# g_serial is built in and defaults to CDC ACM. The UDC may finish
		# probing after userspace starts, so leave readiness to the getty wrapper.
		set -- /sys/class/udc/*
		if [ -e "$1" ]; then
			echo "USB CDC ACM console enabled"
		else
			echo "USB device controller is not available" >&2
		fi
		;;
	stop|restart)
		;;
esac

exit 0
