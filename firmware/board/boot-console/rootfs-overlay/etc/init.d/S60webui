#!/bin/sh

case "$1" in
	start)
		if pidof httpd >/dev/null 2>&1; then
			exit 0
		fi
		echo "Starting Prometheus metrics endpoint"
		httpd -p 80 -h /www
		;;
	stop)
		killall httpd 2>/dev/null || true
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
