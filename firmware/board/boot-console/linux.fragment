# Boot media and the only physical console.
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# Native F1C200s USB device controller and a configfs composite gadget.
CONFIG_USB_SUPPORT=y
# CONFIG_USB is not set
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
# CONFIG_USB_G_SERIAL is not set
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_EXTCON=y

# IPv4 is used only on the point-to-point USB ECM link.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# PC0 active-low status LED, with CPU activity selected at boot.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y

# Keep runtime state off the read-only root filesystem.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# Deliberately unused board interfaces.
# CONFIG_WLAN is not set
# CONFIG_SPI is not set
# CONFIG_I2C is not set
# CONFIG_SOUND is not set
